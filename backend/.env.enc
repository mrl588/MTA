# MTA API
MTA_API_KEY=your_mta_api_key_here

# Firebase Admin SDK — server-side only (NOT the VITE_ client keys)
#
# Option 1 — Render/production (recommended):
#   Paste the entire service account JSON as a single-line string in the Render dashboard
#   Variable name: FIREBASE_SERVICE_ACCOUNT_JSON
#
# Option 2 — Local dev:
#   Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
#   Save as firebase-service-account.json in the backend/ folder
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=nyc-transit-hub-4075d

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret

# Database
# Local dev: leave blank to use SQLite (mta_transit.db)
# Render: leave blank (SQLite works fine on Render's persistent disk)
# DATABASE_URL=postgresql://user:password@host/dbname

# Cache TTL in seconds (how often to re-fetch from MTA API)
CACHE_TTL_SECONDS=30
